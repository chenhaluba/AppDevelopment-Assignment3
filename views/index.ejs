<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HTTP Quest</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="page-container">

    <header class="header">
        <div>
            <p class="assignment-title">Assignment 3</p>
            <h1>HTTP Quest</h1>
            <p class="subtitle">Practice HTTP and REST by building real requests.</p>
        </div>

        <a class="schemas-button" href="/schemas">Schemas</a>
    </header>

    <main class="game-grid">

        <section class="card request-card">

            <span id="stageNumber" class="stage-number"></span>

            <h2 id="stageTitle"></h2>
            <p id="stageDescription" class="description"></p>

            <div class="line"></div>

            <div class="form-group">
                <label for="method">HTTP Method</label>
                <select id="method">
                    <option value="GET">GET</option>
                    <option value="POST">POST</option>
                    <option value="PUT">PUT</option>
                    <option value="DELETE">DELETE</option>
                </select>
            </div>

            <div class="form-group">
                <label for="path">Request Path</label>
                <input id="path" type="text" placeholder="/api/...">
            </div>

            <div id="routeGroup" class="form-group hidden">
                <label for="route">Route Parameters</label>
                <input id="route" type="text" placeholder="id=2">
            </div>

            <div id="queryGroup" class="form-group hidden">
                <label for="query">Query Parameters</label>
                <input id="query" type="text" placeholder="key=value&key2=value2">
            </div>

            <div id="bodyGroup" class="form-group hidden">
                <label for="body">Request Body</label>
                <textarea id="body" rows="5" placeholder='{"field":"value"}'></textarea>
            </div>

            <button id="sendBtn" class="send-button">Send Request</button>

        </section>

        <section class="card response-card">

            <div class="response-top">
                <h3>Server Response</h3>
                <span id="status" class="status">-</span>
            </div>

            <div id="message" class="message">
                Send a request to see the server response.
            </div>

            <div class="response-box">
                <pre id="result">{}</pre>
            </div>

            <button id="nextBtn" class="next-button hidden">Next Stage</button>

        </section>

    </main>
</div>

<div id="completionModal" class="modal hidden">
    <div class="modal-content">

        <button id="closeModalBtn" class="modal-close">&times;</button>

        <div class="modal-icon">✓</div>
        <h2>Game Completed!</h2>
        <p>You completed all 8 stages.</p>

        <button id="restartBtn" class="restart-button">Start Again</button>

    </div>
</div>

<script id="stagesData" type="application/json">
    <%- JSON.stringify(stages) %>
</script>

<script src="/js/app.js"></script>

</body>
</html>
